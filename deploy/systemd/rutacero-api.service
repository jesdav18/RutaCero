[Unit]
Description=Ruta Cero API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=rutacero
Group=rutacero
WorkingDirectory=/var/www/rutacero/api/current
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
EnvironmentFile=/etc/rutacero/rutacero.env
ExecStart=/usr/bin/dotnet /var/www/rutacero/api/current/RutaCero.Api.dll
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/rutacero/shared/storage

[Install]
WantedBy=multi-user.target
